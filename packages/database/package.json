{
  "name": "@event-management/database",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "seed": "ts-node seeds/seed.ts",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist node_modules .turbo"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^17.3.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@event-management/eslint-config": "workspace:*",
    "@event-management/prettier-config": "workspace:*",
    "@event-management/typescript-config": "workspace:*",
    "@faker-js/faker": "^9.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.0.0",
    "eslint": "^9.28.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
